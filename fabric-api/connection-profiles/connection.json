{
  "name": "rawmaterialsupply-network",
  "version": "1.0.0",
  "client": {
    "organization": "Manufacturer",
    "connection": {
      "timeout": {
        "peer": {
          "endorser": "300"
        }
      }
    }
  },
  "channels": {
    "rawmaterialsupply": {
      "orderers": [
        "orderer0.orderer.com"
      ],
      "peers": {
        "peer0.manufacturer.com": {
          "endorsingPeer": true,
          "chaincodeQuery": true,
          "ledgerQuery": true,
          "eventSource": true
        }
      }
    }
  },
  "organizations": {
    "Manufacturer": {
      "mspid": "manufacturerMSP",
      "peers": [
        "peer0.manufacturer.com"
      ]
    }
  },
  "orderers": {
    "orderer0.orderer.com": {
      "url": "grpcs://192.168.100.10:7050",
      "grpcOptions": {
        "ssl-target-name-override": "orderer0.orderer.com"
      },
      "tlsCACerts": {
        "path": "../crypto-config/ordererOrganizations/orderer.com/orderers/orderer0.orderer.com/tls/ca.crt"
      }
    }
  },
  "peers": {
    "peer0.manufacturer.com": {
      "url": "grpcs://192.168.100.30:7051",
      "grpcOptions": {
        "ssl-target-name-override": "peer0.manufacturer.com"
      },
      "tlsCACerts": {
        "path": "../crypto-config/peerOrganizations/manufacturer.com/peers/peer0.manufacturer.com/tls/ca.crt"
      }
    }
  }
}